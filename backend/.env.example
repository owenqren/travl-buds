# Copy to backend/.env for `docker compose up` (backend/.env is gitignored).
# Database URL/credentials are set by docker-compose.yml for the local Postgres container.
GROQ_API_KEY=
JWT_SECRET=

# Optional: needed only for forgot-password emails to actually send
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
APP_FRONTEND_URL=http://localhost:5173
